# Copy to backend/.env for local development (never commit the real .env).
PORT=5000
# AI_SERVICE_URL=http://localhost:8000
# Shared secret checked by the AI service (X-Internal-Key)
# AI_INTERNAL_KEY=
# How long to wait for an AI answer before the built-in rule engine replies (ms)
# AI_TIMEOUT_MS=90000

# --- Admin auth ---
# Random string, >= 32 chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=2h
# Hashes from: node scripts/hash_password.js '<password>'
ADMIN_OWNER_USERNAME=admin
ADMIN_OWNER_PASSWORD_HASH=
ADMIN_WAREHOUSE_USERNAME=kho
ADMIN_WAREHOUSE_PASSWORD_HASH=
# Base32 TOTP secret for Google Authenticator (required in production)
ADMIN_TOTP_SECRET=
# true only while pairing Google Authenticator: the login page then offers the setup QR
# (it contains the secret). Turn it off again after pairing.
# ADMIN_TOTP_ENROLLMENT=false
# Optional emergency OTP (6 digits); disabled when empty
ADMIN_MASTER_OTP=
# Local only: expose /admin/auth/otp-setup (incl. the current code) without login. Ignored in production.
ADMIN_OTP_DEV_HELPER=false

# --- CORS (defaults to localhost:5173/5174 when unset outside production) ---
# FRONTEND_ORIGIN=http://localhost:5173
# ADMIN_ORIGIN=http://localhost:5174
# Extra exact browser origins, comma-separated (localhost is allowed automatically outside production)
# CORS_ORIGINS=https://my-shop.onrender.com,https://my-admin.onrender.com
# TRUST_PROXY=1
