# Vietnamese embedding + evidence reranker worker (CPU). Models are mounted read-only.
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch>=2.8,<3" \
 && pip install --no-cache-dir "transformers>=4.57,<6" "safetensors>=0.6" "huggingface-hub>=0.34" pyvi==0.1.1 "requests>=2.32,<3"

COPY scripts/vietnamese_embedding_service.py scripts/

ENV PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=4 \
    VI_EMBEDDING_HOST=0.0.0.0 \
    VI_UNDERSTANDING_ADAPTER=0

EXPOSE 8011
CMD ["python", "scripts/vietnamese_embedding_service.py"]
