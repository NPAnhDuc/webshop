LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
PLANNER_MODEL=qwen3:4b-instruct-2507-q4_K_M
PLANNER_NUM_GPU=99
CONVERSATION_MODE=semantic
VI_EMBEDDING_URL=http://127.0.0.1:8011
VI_UNDERSTANDING_URL=http://127.0.0.1:8011
ADMIN_PASSWORD=
KEV_BASE_URL=http://127.0.0.1:8009
KEV_THRESHOLD=0.85
SHOP_DATABASE=data/structured/shop.db
OLLAMA_NUM_GPU=99
RAG_SYNTHESIS=1
RAG_ANSWER_MODE=extractive
RAG_RERANK=0
SALES_ADVISOR=1
CHATBOT_MODE=basic_rag

# api_server.py: the web backend sends AI_INTERNAL_KEY as X-Internal-Key.
# /api/chat/admin stays locked while it is empty. Use a long random value.
AI_INTERNAL_KEY=
# Browser origins allowed by CORS (comma-separated); empty = server-to-server only.
AI_ALLOWED_ORIGINS=
AI_SESSION_TTL=1800
AI_SESSION_LIMIT=5000
